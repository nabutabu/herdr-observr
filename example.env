# herdr-observr plugin config

Copy to HERDR_PLUGIN_CONFIG_DIR/.env and fill in as needed. Every key is
optional. Comment lines start with #; lines are KEY=VALUE (an optional
`export ` prefix is tolerated).

The config file (".env" in the plugin's config dir) is the highest-precedence
source: keys set here win over the process environment and built-in defaults.
Keys not set here fall back to the standard OTEL_EXPORTER_OTLP_* environment
variables and OTel SDK defaults, so this file is an override layer, not a
replacement.

# --- OTLP exporter ---------------------------------------------------------
# Where telemetry is exported (metrics, logs, and traces share one endpoint).
# Default: OTEL_EXPORTER_OTLP_ENDPOINT env var, else the SDK default.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Plaintext vs TLS. DEFAULT TRUE (plaintext local collector) for both the
# pre-4.2 behavior and installs with no config file. Set explicitly to false
# to switch the exporter to TLS — this is the ONLY supported way to force TLS;
# a shell-level OTEL_EXPORTER_OTLP_INSECURE cannot, by design, because the OTel
# exporters expose no force-TLS override.
#OTEL_EXPORTER_OTLP_INSECURE=false

# Timeout for a single export attempt. Default: SDK's OTEL_EXPORTER_OTLP_TIMEOUT.
#OTEL_EXPORTER_OTLP_TIMEOUT=10s

# Extra gRPC metadata on every export (comma-separated key=value pairs).
# Common for auth/proxy headers. Default: SDK's OTEL_EXPORTER_OTLP_HEADERS.
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token

# --- Resource --------------------------------------------------------------
# service.name for the telemetry. Default: OTEL_SERVICE_NAME, else
# herdr-telemetry.
#OTEL_SERVICE_NAME=herdr-telemetry

# Extra resource attributes (comma-separated key=value pairs). Same-key
# entries here win over OTEL_RESOURCE_ATTRIBUTES.
#OTEL_RESOURCE_ATTRIBUTES=env=prod,region=eu

# --- Plugin-specific ---------------------------------------------------------
# Override herdr.machine.id (the persisted plugin UUID). Use for a fixed
# cross-machine identity. Wins over the persisted/derived value.
#HERDR_OBSRVR_MACHINE_ID=

# Per-workspace datapoints on the herdr.agent.* gauges and the
# herdr.workspace.agent.concurrent gauge. DEFAULT TRUE: dashboards and the
# workspace-concurrency signal depend on the dimension. Set false to collapse
# the 3.6 gauges to global datapoints and drop the 3.7 gauge for backends that
# cannot take 5 x N_workspaces series per machine.
#HERDR_OBSRVR_EMIT_PER_WORKSPACE_GAUGES=false